{
  "name": "econradar",
  "version": "1.0.0",
  "description": "EconRadar - 国内外主要指数与宏观经济指标雷达",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.steven.econradar",
    "productName": "EconRadar",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "EconRadar"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
